  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "expo-doctor",
    "verify:bluetooth": "node scripts/verify-bluetooth-integration.cjs",
