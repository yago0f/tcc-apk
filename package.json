    "prebuild:android": "expo prebuild --platform android --clean",
    "verify:syntax": "node scripts/parse-js.cjs",
    "audit": "node scripts/audit-project.cjs",
    "verify": "npm run verify:syntax && npm run audit && npm run verify:bluetooth && npm run verify:gradle-fix && npm run verify:startup",
    "postinstall": "node scripts/fix-gradle-foojay.cjs",
    "verify:gradle-fix": "node scripts/test-fix-gradle-foojay.cjs",
