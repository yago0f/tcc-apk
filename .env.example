# A API PHP deve estar em C:\laragon\www\rebirth-api.
#
# O aplicativo já tenta descobrir automaticamente o IP do computador usado
# pelo Expo. Caso a descoberta automática não funcione, copie este arquivo
# para .env e informe o IPv4 do computador.
#
# Exemplo para development build/APK no celular:
# EXPO_PUBLIC_API_URL=http://192.168.0.10/rebirth-api
#
# Exemplo para Expo Web no mesmo computador:
# EXPO_PUBLIC_API_URL=http://localhost/rebirth-api

EXPO_PUBLIC_API_URL=
